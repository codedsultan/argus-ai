# LLM (OpenAI-compatible). Leave blank for replay mode.
LLM_BASE_URL=
LLM_MODEL=azure/gpt-5.5
API_KEY=
LLM_TLS_VERIFY=true

# Replay. true = use cassettes and require no API key.
USE_VCR=true
VCR_CASSETTE_DIR=evals/cassettes
VCR_MATCH_THRESHOLD=0.85
# new_episodes lets a local operator extend a cassette. Public deployments set
# none so a miss fails closed instead of attempting a provider request.
VCR_RECORD_MODE=new_episodes

# Public profile. Keep false for the full local lab.
PUBLIC_MODE=false
# Optional shared secret between the Next.js BFF and the public proxy. Set the
# same value as ARGUS_BFF_TOKEN in the frontend. Blank disables the check.
PUBLIC_BFF_TOKEN=
PUBLIC_RATE_LIMIT_PER_MINUTE=12
PUBLIC_MAX_CONCURRENT=4
MAX_PROMPT_BYTES=16384
ARGUS_VERSION=dev

# Agent
GRAPH_RECURSION_LIMIT=25
# History budget (0 disables trimming). Estimate is ~4 chars per token.
HISTORY_MAX_TOKENS=8000
HISTORY_MIN_RECENT=2

# Optional local stress knobs (0 disables).
AI_SLOW_RESPONSE_MS=0
AI_RUNAWAY_ITERATIONS=0

# Domain
APPLICATION_ENDPOINT=localhost:8080

# Compose host ports (the containers keep their internal ports)
SHOP_API_PORT=8080
AGENT_PORT=8010
JAEGER_PORT=16686
OTEL_GRPC_PORT=4317
OTEL_HTTP_PORT=4318

# Telemetry
OTEL_ENABLED=true
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
OTEL_EXPORTER_OTLP_INSECURE=true
OTEL_SERVICE_NAME=agent
TRACELOOP_BASE_URL=http://localhost:4318
# Disable Traceloop's own product telemetry; OTLP traces still go to the collector.
TRACELOOP_TELEMETRY=false
# false stops the Traceloop decorators from recording prompt/completion content.
# It is a stronger privacy control than collector-side redaction.
TRACELOOP_TRACE_CONTENT=true

# Test targets (used by the integration tests)
AGENT_URL=http://localhost:8010
JAEGER_URL=http://localhost:16686
COLLECTOR_HTTP_URL=http://localhost:4318
